<UserControl x:Class="AutoCardCopier.App.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
      <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,6,0,16" />
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="当前状态" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="数据位置" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="数据目录" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
          <TextBox Text="{Binding DataDirectory, Mode=OneWay}" Style="{StaticResource AppTextBox}"
                   IsReadOnly="True" Margin="0,2,0,10" />
          <TextBlock Text="配置文件" Style="{StaticResource SecondaryText}" />
          <TextBox Text="{Binding SettingsPath, Mode=OneWay}" Style="{StaticResource AppTextBox}"
                   IsReadOnly="True" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
