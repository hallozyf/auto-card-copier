<UserControl x:Class="AutoCardCopier.App.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,20,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
      <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding SummaryText}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="打开目标目录" Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Margin="0,0,8,0" />
          <Button Content="打开日志目录" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogCommand}" Margin="0,0,8,0" />
          <Button Content="刷新" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="2" Style="{StaticResource CardBorder}">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0" />
        <ListView ItemsSource="{Binding Tasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                  Style="{StaticResource AppListView}" ItemContainerStyle="{StaticResource AppListViewItem}">
          <ListView.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusDisplay}" Style="{StaticResource BodyText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding ProjectName}" Style="{StaticResource BodyText}" />
                  <TextBlock Text="{Binding MessageText}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding SpeedText}" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
