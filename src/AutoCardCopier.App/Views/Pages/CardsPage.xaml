<UserControl x:Class="AutoCardCopier.App.Views.Pages.CardsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,20,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
      <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
    </StackPanel>

    <!-- 状态条：状态 + 进度 + 主要动作 -->
    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" />
          <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
          <!-- 扫描等不确定进度用滚动条；拷贝过程由下方的拷贝卡片显示精确进度 -->
          <ProgressBar Style="{StaticResource AppProgressBar}" Margin="0,8,0,0" Maximum="100"
                       IsIndeterminate="True"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="刷新" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
          <Button Content="扫描素材" Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
          <Button Content="开始拷贝" Style="{StaticResource PrimaryButton}" Command="{Binding StartCopyCommand}" Margin="0,0,8,0" />
          <Button Content="继续上次任务" Style="{StaticResource SecondaryButton}" Command="{Binding ResumeCommand}" Margin="0,0,8,0" />
          <Button Content="{Binding PauseButtonText}" Style="{StaticResource SecondaryButton}" Command="{Binding PauseResumeCommand}" Margin="0,0,8,0" />
          <Button Content="取消" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCopyCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- 卡片列表 -->
      <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="检测到的存储卡" Style="{StaticResource SectionTitleText}" Margin="8,6,0,6" />
          <ListView ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                    Style="{StaticResource AppListView}" ItemContainerStyle="{StaticResource AppListViewItem}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0">
                    <Run Text="{Binding DriveLetter, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding FileSystem, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="{Binding CapacityText}" Style="{StaticResource SecondaryText}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- 拍摄信息 -->
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="拍摄信息" Style="{StaticResource SectionTitleText}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="90" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="拍摄地点" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,6" />
                <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource AppComboBox}" Margin="0,4,12,4"
                          IsEditable="True" ItemsSource="{Binding Locations}"
                          Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="拍摄类型" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,6" />
                <ComboBox Grid.Row="0" Grid.Column="3" Style="{StaticResource AppComboBox}" Margin="0,4,0,4"
                          IsEditable="True" ItemsSource="{Binding ShootTypes}"
                          Text="{Binding ShootType, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="摄影师" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,6" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource AppTextBox}" Margin="0,4,12,4"
                         Text="{Binding Photographer, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="备注" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,6" />
                <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource AppTextBox}" Margin="0,4,0,4"
                         Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="目标目录" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,6" />
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding TargetPreviewText}"
                           Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,6" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 多日分组（F13）：仅在检测到多个拍摄日期时显示 -->
          <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasMultipleGroups, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="按拍摄日期自动分组" Style="{StaticResource SectionTitleText}" />
              <TextBlock Text="{Binding GroupSummaryText}" Style="{StaticResource SecondaryText}" />

              <!-- 导入方式（F14-D）：按天拆分 / 合并为一个项目 -->
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <RadioButton Style="{StaticResource AppRadioButton}" GroupName="GroupImportMode"
                             Content="按天拆分（每天一个项目）" Margin="0,0,20,0"
                             IsChecked="{Binding IsSplitByDayMode, Mode=TwoWay}" />
                <RadioButton Style="{StaticResource AppRadioButton}" GroupName="GroupImportMode"
                             Content="合并为一个项目（跨多天）"
                             IsChecked="{Binding IsMergeMode, Mode=TwoWay}" />
              </StackPanel>

              <!-- 合并为一个项目：项目名、日期范围、布局 -->
              <StackPanel Visibility="{Binding ShowMergePanel, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="项目名" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,5" />
                  <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource AppTextBox}" Margin="0,3"
                           Text="{Binding MergeProjectName, UpdateSourceTrigger=PropertyChanged}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="起始日期" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,5" />
                  <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource AppComboBox}" Margin="0,3"
                            ItemsSource="{Binding MergeDateOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                            SelectedValue="{Binding MergeStartDate, Mode=TwoWay}" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="终止日期" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,5" />
                  <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource AppComboBox}" Margin="0,3"
                            ItemsSource="{Binding MergeDateOptions}" DisplayMemberPath="Value" SelectedValuePath="Key"
                            SelectedValue="{Binding MergeEndDate, Mode=TwoWay}" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="地点 / 类型" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,5" />
                  <Grid Grid.Row="3" Grid.Column="1" Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource AppTextBox}" Margin="0,0,6,0"
                             Text="{Binding MergeLocation, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}"
                             Text="{Binding MergeShootType, UpdateSourceTrigger=PropertyChanged}" />
                  </Grid>

                  <TextBlock Grid.Row="4" Grid.Column="0" Text="目录布局" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,5" />
                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                    <RadioButton Style="{StaticResource AppRadioButton}" GroupName="MergeLayout"
                                 Content="合并放一起（照片 / 视频）" Margin="0,0,20,0"
                                 IsChecked="{Binding IsFlatLayout, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource AppRadioButton}" GroupName="MergeLayout"
                                 Content="一天一个文件夹（日期 / 照片）"
                                 IsChecked="{Binding IsByDayLayout, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>

                <TextBlock Text="{Binding MergePreviewText}" Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="合并后所有天的素材写入同一项目；日期范围必须覆盖本次素材，否则会拒绝开始拷贝。"
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>

              <!-- 按天拆分：统一填写 + 每个日期一行 -->
              <StackPanel Visibility="{Binding IsSplitByDayMode, Converter={StaticResource BoolToVisibility}}">
                <Grid Margin="0,10,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="统一地点" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBox Grid.Column="1" Style="{StaticResource AppTextBox}" Margin="0,0,10,0"
                           Text="{Binding BulkLocation, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Grid.Column="2" Text="统一类型" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                  <TextBox Grid.Column="3" Style="{StaticResource AppTextBox}" Margin="0,0,10,0"
                           Text="{Binding BulkShootType, UpdateSourceTrigger=PropertyChanged}" />
                  <Button Grid.Column="4" Content="应用到全部" Style="{StaticResource SecondaryButton}"
                          Command="{Binding ApplyBulkCommand}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Groups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DateText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RangeText}" Style="{StaticResource SecondaryText}" />
                            <TextBlock Text="{Binding CountText}" Style="{StaticResource SecondaryText}" />
                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource SecondaryText}" />
                          </StackPanel>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="项目名" Style="{StaticResource SecondaryText}" />
                            <TextBox Style="{StaticResource AppTextBox}" Margin="0,2,0,6"
                                     Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Margin="0,0,0,4">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="地点" Style="{StaticResource SecondaryText}" />
                                <TextBox Style="{StaticResource AppTextBox}" Margin="0,2,0,0"
                                         Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" />
                              </StackPanel>
                              <StackPanel Grid.Column="1">
                                <TextBlock Text="类型" Style="{StaticResource SecondaryText}" />
                                <TextBox Style="{StaticResource AppTextBox}" Margin="0,2,0,0"
                                         Text="{Binding ShootType, UpdateSourceTrigger=PropertyChanged}" />
                              </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding TargetPreviewText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 追加到已有项目（F14-B）：日期不匹配时会被整批拒绝 -->
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="追加到已有项目" Style="{StaticResource SectionTitleText}" />
              <TextBlock Text="{Binding AppendRangeText}" Style="{StaticResource SecondaryText}" />
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Margin="0,0,10,0" MinHeight="30"
                          ItemsSource="{Binding AppendCandidates}"
                          SelectedItem="{Binding SelectedAppendProject}"
                          DisplayMemberPath="Name" />
                <Button Grid.Column="1" Content="追加到该项目" Style="{StaticResource SecondaryButton}"
                        Command="{Binding StartAppendCommand}" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 素材统计 -->
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="素材统计" Style="{StaticResource SectionTitleText}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="内容类型" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ContentSummaryText}" Style="{StaticResource BodyText}" Margin="0,3" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="照片" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PhotoText}" Style="{StaticResource BodyText}" Margin="0,3" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="视频" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VideoText}" Style="{StaticResource BodyText}" Margin="0,3" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="其他文件" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OtherText}" Style="{StaticResource BodyText}" Margin="0,3" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="合计" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource BodyText}" Margin="0,3" FontWeight="SemiBold" />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="拍摄时间" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TimeRangeText}" Style="{StaticResource BodyText}" Margin="0,3" />
                <TextBlock Grid.Row="6" Grid.Column="0" Text="相机型号" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CameraModelText}" Style="{StaticResource BodyText}" Margin="0,3" />
              </Grid>
              <TextBlock Text="扫描范围" Style="{StaticResource SecondaryText}" Margin="0,10,0,2" />
              <TextBlock Text="{Binding ScanScopeText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CoverageText}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0"
                         Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- 拷贝进度与结果 -->
          <Border Style="{StaticResource CardBorder}" Visibility="{Binding IsCopying, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="拷贝中" Style="{StaticResource SectionTitleText}" />
              <ProgressBar Style="{StaticResource AppProgressBar}" Maximum="100" Value="{Binding CopyPercent, Mode=OneWay}" Height="10" />
              <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,0">
                <Run Text="{Binding CopySpeedText, Mode=OneWay}" />
                <Run Text=" · " />
                <Run Text="{Binding CopyEtaText, Mode=OneWay}" />
              </TextBlock>
              <TextBlock Text="{Binding CopyCurrentFile}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="本次结果" Style="{StaticResource SectionTitleText}" />
              <TextBlock Text="{Binding ResultSummary}" Style="{StaticResource BodyText}" />
              <ItemsControl ItemsSource="{Binding Failures}" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" Foreground="{DynamicResource ErrorBrush}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 格式化卡片：只有在"本次拷贝 + 校验通过"之后才会解锁 -->
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="格式化卡片" Style="{StaticResource SectionTitleText}" />
              <TextBlock Text="{Binding FormatHintText}" Style="{StaticResource SecondaryText}" />
              <TextBlock Text="{Binding ResumeHintText}" Style="{StaticResource SecondaryText}"
                         Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0"
                         Visibility="{Binding HasResumeHint, Converter={StaticResource BoolToVisibility}}" />
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="格式化卡片" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                        Command="{Binding FormatCardCommand}" />
                <Button Content="清空卡片文件" Style="{StaticResource SecondaryButton}"
                        Command="{Binding EraseCardCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
