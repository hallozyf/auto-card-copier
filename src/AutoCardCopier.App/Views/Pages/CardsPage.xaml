<UserControl x:Class="AutoCardCopier.App.Views.Pages.CardsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="24,20,24,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 标题 -->
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
      <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
    </StackPanel>

    <!-- 工具条 -->
    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" />
          <TextBlock Text="{Binding ProgressText}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
          <ProgressBar Style="{StaticResource AppProgressBar}" Margin="0,8,12,0" Maximum="100"
                       IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="刷新" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
          <Button Content="扫描素材" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主体：卡片列表 + 详情 -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="290" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,12,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="检测到的存储卡" Style="{StaticResource SectionTitleText}" Margin="8,6,0,6" />
          <ListView ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                    Style="{StaticResource AppListView}" ItemContainerStyle="{StaticResource AppListViewItem}"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                  <TextBlock Style="{StaticResource SecondaryText}" Margin="0,2,0,0">
                    <Run Text="{Binding DriveLetter, Mode=OneWay}" />
                    <Run Text=" · " />
                    <Run Text="{Binding FileSystem, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="{Binding CapacityText}" Style="{StaticResource SecondaryText}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </DockPanel>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- 扫描结果 -->
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="素材统计" Style="{StaticResource SectionTitleText}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="内容类型" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ContentSummaryText}" Style="{StaticResource BodyText}" Margin="0,3" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="照片" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PhotoText}" Style="{StaticResource BodyText}" Margin="0,3" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="视频" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VideoText}" Style="{StaticResource BodyText}" Margin="0,3" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="其他文件" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OtherText}" Style="{StaticResource BodyText}" Margin="0,3" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="合计" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalText}" Style="{StaticResource BodyText}" Margin="0,3" FontWeight="SemiBold" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="拍摄时间" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TimeRangeText}" Style="{StaticResource BodyText}" Margin="0,3" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="相机型号" Style="{StaticResource SecondaryText}" Margin="0,3" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CameraModelText}" Style="{StaticResource BodyText}" Margin="0,3" />
              </Grid>
            </StackPanel>
          </Border>

          <!-- 卡片信息 -->
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="卡片信息" Style="{StaticResource SectionTitleText}" />
              <TextBlock Text="{Binding SelectedCard.DetectionReason}" Style="{StaticResource BodyText}" />
              <TextBlock Text="{Binding SelectedCard.MediaFoldersText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
              <TextBlock Text="{Binding TargetHintText}" Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="接下来的步骤" Style="{StaticResource SectionTitleText}" />
              <TextBlock Style="{StaticResource BodyText}"
                         Text="M3 里程碑将在这里加入拍摄地点与类型填写、目标目录预览、并行拷贝与校验。" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
