<UserControl x:Class="AutoCardCopier.App.Views.Pages.CardsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
    <StackPanel>
      <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleText}" />
      <TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryText}" Margin="0,6,0,16" />
      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="当前状态" Style="{StaticResource SectionTitleText}" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource BodyText}" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorder}">
        <StackPanel>
          <TextBlock Text="计划的拷卡流程" Style="{StaticResource SectionTitleText}" />
          <TextBlock Style="{StaticResource BodyText}" Text="1. 插入内存卡后自动识别并扫描素材（F01、F02）" />
          <TextBlock Style="{StaticResource BodyText}" Text="2. 填写拍摄地点与类型，软件自动规划目标目录（F03、F07）" />
          <TextBlock Style="{StaticResource BodyText}" Text="3. 并行拷贝并实时显示进度与剩余时间（F04）" />
          <TextBlock Style="{StaticResource BodyText}" Text="4. 自动校验并生成校验清单与项目文件（F05、F06）" />
          <TextBlock Style="{StaticResource BodyText}" Text="5. 校验通过后可选一键格式化卡片（F10）" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
