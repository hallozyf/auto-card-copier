<Window x:Class="AutoCardCopier.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="自动拷卡助手"
        Width="1080" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <!-- 自绘标题栏：保留系统级的拖动、双击最大化、窗口贴边与缩放能力 -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <!-- ================= 标题栏 ================= -->
    <Grid Grid.Row="0" Background="{DynamicResource WindowBackgroundBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="&#xE722;" Style="{StaticResource IconText}"
                 Margin="14,0,8,0" Foreground="{DynamicResource AccentBrush}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding WindowTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding VersionText}" Style="{StaticResource SecondaryText}" Margin="8,0,0,0" />
      </StackPanel>

      <!-- 这一列是拖动区，交给 WindowChrome 处理 -->
      <Border Grid.Column="2" Background="Transparent" />

      <StackPanel Grid.Column="3" Orientation="Horizontal"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Content="&#xE921;" Style="{StaticResource TitleBarButton}"
                Click="OnMinimizeClick" ToolTip="最小化" />
        <Button Content="&#xE922;" Style="{StaticResource TitleBarButton}"
                Click="OnMaximizeClick" ToolTip="最大化 / 还原" />
        <Button Content="&#xE8BB;" Style="{StaticResource CloseTitleBarButton}"
                Click="OnCloseClick" ToolTip="关闭" />
      </StackPanel>
    </Grid>

    <!-- ================= 主体：左侧导航 + 右侧内容 ================= -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource SurfaceAltBrush}"
              BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,1,0">
        <DockPanel>
          <ListBox DockPanel.Dock="Top" x:Name="NavigationList"
                   ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                   ItemContainerStyle="{StaticResource NavigationItem}"
                   Background="Transparent" BorderThickness="0" Margin="0,8,0,0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Width="26" />
                  <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SecondaryText}" Margin="16,0,16,14"
                     Text="{Binding FooterText}" HorizontalAlignment="Left" />
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource WindowBackgroundBrush}">
        <ContentControl Content="{Binding CurrentViewModel}" />
      </Border>
    </Grid>

    <!-- ================= 状态栏 ================= -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceAltBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}" Style="{StaticResource SecondaryText}"
                 VerticalAlignment="Center" Margin="16,0" />
    </Border>
  </Grid>
</Window>
