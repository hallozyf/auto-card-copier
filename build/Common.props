<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    全解决方案共享的编译属性。
    说明：本机未安装 .NET SDK 与 .NET Framework 4.x 参考程序集，
    因此通过 FrameworkPathOverride 指向系统自带运行时目录作为参考程序集。
    若日后安装了正式 Targeting Pack 或 .NET SDK，删掉该属性即可。
  -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <OutputPath>$(RepoRoot)build\out\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == '' AND Exists('C:\Windows\Microsoft.NET\Framework64\v4.0.30319\mscorlib.dll')">C:\Windows\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>1591</NoWarn>
    <Deterministic>true</Deterministic>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Version>0.1.0</Version>
  </PropertyGroup>
</Project>
